PORT=3000
LOG_LEVEL=info
N8N_WEBHOOK_URL=http://localhost:5678/webhook/wa-incoming
# Upstash: ambil dari dashboard database -> tab "Connect" -> koneksi ioredis (diawali rediss://)
REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379
# Rate limit anti-ban untuk POST /messages/send (default: 20 pesan / 60 detik, berlaku global bukan per-IP)
SEND_RATE_LIMIT_MAX=20
SEND_RATE_LIMIT_WINDOW_MS=60000
# Passphrase untuk enkripsi auth_state/ (AES-256-GCM). WAJIB diisi dengan nilai rahasia sendiri,
# JANGAN pakai contoh ini. Generate: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
AUTH_STATE_ENCRYPTION_KEY=ganti-dengan-passphrase-rahasia-anda-sendiri
